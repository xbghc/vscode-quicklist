{
  "name": "quicklist",
  "displayName": "Quicklist",
  "description": "A minimal workspace file and folder shortcut list in Explorer.",
  "version": "0.3.0",
  "publisher": "xbghc",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "quicklist",
    "shortcuts",
    "favorites",
    "files",
    "explorer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xbghc/vscode-quicklist.git"
  },
  "bugs": {
    "url": "https://github.com/xbghc/vscode-quicklist/issues"
  },
  "homepage": "https://github.com/xbghc/vscode-quicklist#readme",
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "quicklist",
          "name": "Quicklist",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "quicklist.addCurrentFile",
        "title": "Add Current File",
        "category": "Quicklist",
        "icon": "$(add)"
      },
      {
        "command": "quicklist.addFromExplorer",
        "title": "Add to Quicklist"
      },
      {
        "command": "quicklist.remove",
        "title": "Remove from Quicklist",
        "icon": "$(close)"
      },
      {
        "command": "quicklist.newFolder",
        "title": "New Folder",
        "category": "Quicklist",
        "icon": "$(new-folder)"
      },
      {
        "command": "quicklist.renameFolder",
        "title": "Rename Folder"
      },
      {
        "command": "quicklist.moveToFolder",
        "title": "Move to Folder\u2026"
      },
      {
        "command": "quicklist.removeFolder",
        "title": "Remove Folder (Keep Contents)"
      },
      {
        "command": "quicklist.refresh",
        "title": "Refresh",
        "category": "Quicklist",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "quicklist.addFromExplorer",
          "when": "workspaceFolderCount > 0",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "quicklist.addCurrentFile",
          "when": "view == quicklist",
          "group": "navigation@1"
        },
        {
          "command": "quicklist.newFolder",
          "when": "view == quicklist",
          "group": "navigation@2"
        },
        {
          "command": "quicklist.refresh",
          "when": "view == quicklist",
          "group": "overflow@1"
        }
      ],
      "commandPalette": [
        {
          "command": "quicklist.renameFolder",
          "when": "false"
        },
        {
          "command": "quicklist.moveToFolder",
          "when": "false"
        },
        {
          "command": "quicklist.removeFolder",
          "when": "false"
        },
        {
          "command": "quicklist.addFromExplorer",
          "when": "false"
        },
        {
          "command": "quicklist.remove",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "quicklist.newFolder",
          "when": "webviewId == quicklist && webviewSection == quicklistGroup",
          "group": "navigation@1"
        },
        {
          "command": "quicklist.addCurrentFile",
          "when": "webviewId == quicklist && webviewSection == quicklistGroup",
          "group": "navigation@2"
        },
        {
          "command": "quicklist.renameFolder",
          "when": "webviewId == quicklist && webviewSection == quicklistGroup",
          "group": "quicklist@1"
        },
        {
          "command": "quicklist.moveToFolder",
          "when": "webviewId == quicklist && webviewSection =~ /^quicklist(Entry|Group)$/",
          "group": "quicklist@2"
        },
        {
          "command": "quicklist.removeFolder",
          "when": "webviewId == quicklist && webviewSection == quicklistGroup",
          "group": "quicklist@3"
        },
        {
          "command": "quicklist.remove",
          "when": "webviewId == quicklist && webviewSection == quicklistEntry",
          "group": "quicklist@4"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check quicklist-view.js && node --check media/quicklist.js && node --check tests/run-webview.js && node --check tests/run-vscode.js && node --check tests/integration/index.js && node --check tools/release.js && npm test",
    "test": "node --test tests/extension.test.js tests/folders.test.js tests/webview.test.js tests/release.test.js",
    "test:integration": "node tests/run-vscode.js",
    "package": "npx --yes @vscode/vsce@3.6.2 package --no-dependencies",
    "package:offline": "python3 tools/build_vsix.py",
    "test:setup": "npm install --no-save --package-lock=false --ignore-scripts @vscode/test-electron@3.1.0",
    "test:webview": "node tests/run-webview.js"
  }
}
